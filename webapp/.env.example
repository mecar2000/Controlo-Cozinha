# Copy to .env and fill in for your machine. All values here are read once at
# startup by app/config.py — restart the process after changing this file.

# --- MQTT broker (same broker the kitchen firmware and DataAcquisition use) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- Kitchen device identity ---
# Must match DEVICE_LOCATION / the device id the firmware publishes as, i.e.
# "{MAC}-Kitchen" per DataAcquisition/README.md. Used to build every
# KitchenControl/{deviceId}/... topic.
KITCHEN_DEVICE_ID=KITCHEN-01

# --- Flask web server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5010

# Bearer token auth for THIS app's own routes. Leave empty to disable (open,
# fine for a lab machine on a trusted network; matches DataAcquisition's model).
# Sent as "Authorization: Bearer ..." only — never accepted in a query string,
# since a token in a URL ends up in logs and browser history.
DASHBOARD_TOKEN=

# Extra origins allowed to make state-changing requests (comma-separated,
# e.g. http://lab-pc:8080). Same-origin is always allowed and needs no entry,
# and so does the Vite dev server, which proxies /api. Cross-origin POSTs are
# refused regardless of DASHBOARD_TOKEN: with auth disabled, any page the
# operator has open could otherwise POST /api/runs/start.
ALLOWED_ORIGINS=

# --- DataAcquisition (the historian) ---
# Base URL of the DataAcquisition Flask app. The browser never talks to this
# directly — only this backend does.
DAQ_BASE_URL=http://localhost:5001
# Bearer token DataAcquisition expects, if DASHBOARD_TOKEN is set there.
DAQ_TOKEN=
# Timeout (seconds) for calls that gate starting a run — kept short because a
# hung DAQ must not hang the start path indefinitely.
DAQ_TIMEOUT_S=5
DAQ_LOCATION=Kitchen

# --- KitchenControl SQL Server database (separate DB, same instance as DAQ) ---
DB_SERVER=localhost
DB_NAME=KitchenControl
