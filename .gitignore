/node_modules/
/package.json
/package-lock.json

# Ad-hoc screenshots dropped at repo root (e.g. Playwright visual checks)
/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editors
.vs/
*.swp

Old/

# Firmware secrets — credentials, never commit
kitchen/Kitchen_Secrets.h
centralPLC/Secrets.h

# Local env files — copy from .env.example instead
webapp/.env

# Playwright's regenerable trace/screenshot output from e2e runs
webapp/frontend/test-results/