# PlatformIO / Arduino
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Build logs
*.log

# Node (stray root-level installs — the real frontend deps live in
