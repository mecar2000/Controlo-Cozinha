# Copy to .env and fill in for your machine. Read once at import time by
# runtime.py (all values are seconds, not ms) — restart the sim after
# changing this file. Unset/absent = real-hardware default from
# kitchen_core_sim.py / Kitchen_Settings.h.

# Fully Ventilating minimum hold before auto-exit (real default: 300s / 5 min)
SIM_FULLY_VENT_HOLD_S=

# ARMED -> WAITING timeout if not confirmed (real default: 60s)
SIM_ARM_TIMEOUT_S=

# LOCAL sensor off->on warm-up gate before LEAKING flows gas (real default: 70s)
SIM_SENSOR_WARMUP_S=

# Max HOLD duration placeholder (real default: 600s / 10 min)
SIM_HOLD_MAX_DURATION_S=
